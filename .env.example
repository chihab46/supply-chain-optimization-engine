# Local development only. Copy to .env before starting PostgreSQL.
POSTGRES_DB=supply_chain
POSTGRES_USER=supply_chain
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://supply_chain:local_development_only@localhost:5433/supply_chain

# Dashboard configuration; launch from the project root.
PROJECT_CONFIG=configs/default.yaml
DASH_HOST=127.0.0.1
DASH_PORT=8050
